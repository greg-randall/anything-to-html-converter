# Copy this file to .env and put your API key in LLM_API_KEY. Everything else is ready to use.
#
# It is set up for Anthropic (Claude). To use OpenAI instead, comment out the Anthropic block and uncomment
# the OpenAI block. If a setting appears more than once, the last one is used.

LLM_API_KEY=

# Leave blank for the official Anthropic or OpenAI endpoint; set it for any other server (see the README)
LLM_BASE_URL=

# --- Anthropic ---
LLM_API=anthropic
FORMAT_MODEL=claude-sonnet-5-5
FORMAT_EFFORT=high
ALT_TEXT_MODEL=claude-sonnet-5-5
ALT_TEXT_EFFORT=low

# --- OpenAI ---
# LLM_API=openai
# FORMAT_MODEL=gpt-6.1-terra
# FORMAT_EFFORT=high
# ALT_TEXT_MODEL=gpt-6.1-terra
# ALT_TEXT_EFFORT=low

# --- Both ---
# Most output tokens for the formatting call; a response cut off at this limit stops the run
FORMAT_MAX_TOKENS=64000
ALT_TEXT_MAX_TOKENS=4000
# Minimum words of surrounding text sent before and after each image
ALT_TEXT_CONTEXT_WORDS=50
# Most alt text calls running at once (the formatting call is not counted)
ALT_TEXT_CONCURRENCY=8
# FORMAT_EFFORT and ALT_TEXT_EFFORT are Anthropic effort / OpenAI reasoning_effort; blank uses the API default.
# A blank ALT_TEXT_MODEL uses FORMAT_MODEL.
